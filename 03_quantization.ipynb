 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Model Optimization: Quantization\n",
    "\n",
    "In this notebook, we'll apply quantization techniques to our models to reduce their size and improve inference speed. Quantization works by reducing the precision of the model weights, typically from 32-bit floating point to 8-bit integers."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import torch\n",
    "import time\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, AutoModelForTokenClassification\n",
    "from transformers import AutoModelForQuestionAnswering, AutoModelForMaskedLM\n",
    "import torch.quantization\n",
    "\n",
    "# Import Intel Neural Compressor for CPU optimization\n",
    "try:\n",
    "    from optimum.intel import INCQuantizer, INCModelForSequenceClassification\n",
    "    from optimum.intel import INCModelForTokenClassification, INCModelForQuestionAnswering\n",
    "    intel_optimum_available = True\n",
    "    print(\"Intel Neural Compressor (optimum-intel) is available\")\n",
    "except ImportError:\n",
    "    intel_optimum_available = False\n",
    "    print(\"Intel Neural Compressor (optimum-intel) is not available. Will use PyTorch quantization only.\")\n",
    "\n",
    "# Import utility functions\n",
    "from utils import measure_inference_time, get_model_size, measure_memory_usage, plot_comparison"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Baseline Metrics and Model Information"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load baseline metrics\n",
    "with open('baseline_metrics.json', 'r') as f:\n",
    "    baseline_metrics = json.load(f)\n",
    "\n",
    "# Load model information\n",
    "with open('model_info.json', 'r') as f:\n",
    "    model_info = json.load(f)\n",
    "\n",
    "print(f\"Loaded baseline metrics for {len(baseline_metrics)} models\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Define Sample Inputs for Each Task"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define sample inputs for each task\n",
    "sample_inputs = {\n",
    "    \"sentiment_analysis\": \"I really enjoyed this movie. The acting was superb and the plot was engaging.\",\n",
    "    \"ner\": \"Jeff Bezos founded Amazon in 1994 and the company is headquartered in Seattle, Washington.\",\n",
    "    \"question_answering\": {\n",
    "        \"question\": \"What is machine learning?\",\n",
    "        \"context\": \"Machine learning is a branch of artificial intelligence that focuses on building systems that learn from data.\"\n",
    "    },\n",
    "    \"masked_lm\": \"The [MASK] is a large language model trained by OpenAI.\"\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Create Functions for Loading Models and Preparing Inputs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_model(model_key):\n",
    "    \"\"\"Load model and tokenizer from local path.\"\"\"\n",
    "    model_data = model_info[model_key]\n",
    "    model_path = model_data[\"local_path\"]\n",
    "    task = model_data[\"task\"]\n",
    "    \n",
    "    print(f\"Loading {model_data['model_name']} for {task}...\")\n",
    "    \n",
    "    # Load tokenizer\n",
    "    tokenizer = AutoTokenizer.from_pretrained(model_path)\n",
    "    \n",
    "    # Load model based on task\n",
    "    if task == \"sequence-classification\":\n",
    "        model = AutoModelForSequenceClassification.from_pretrained(model_path)\n",
    "    elif task == \"token-classification\":\n",
    "        model = AutoModelForTokenClassification.from_pretrained(model_path)\n",
    "    elif task == \"question-answering\":\n",
    "        model = AutoModelForQuestionAnswering.from_pretrained(model_path)\n",
    "    elif task == \"masked-lm\":\n",
    "        model = AutoModelForMaskedLM.from_pretrained(model_path)\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported task: {task}\")\n",
    "    \n",
    "    # Move model to GPU if available\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    model = model.to(device)\n",
    "    model.eval()  # Set model to evaluation mode\n",
    "    \n",
    "    return model, tokenizer, device\n",
    "\n",
    "def prepare_inputs(model_key, tokenizer, device):\n",
    "    \"\"\"Prepare inputs for the model based on task.\"\"\"\n",
    "    task = model_info[model_key][\"task\"]\n",
    "    sample_input = sample_inputs[model_key]\n",
    "    \n",
    "    if task == \"sequence-classification\" or task == \"token-classification\":\n",
    "        inputs = tokenizer(sample_input, return_tensors=\"pt\")\n",
    "    elif task == \"question-answering\":\n",
    "        inputs = tokenizer(sample_input[\"question\"], sample_input[\"context\"], return_tensors=\"pt\")\n",
    "    elif task == \"masked-lm\":\n",
    "        inputs = tokenizer(sample_input, return_tensors=\"pt\")\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported task: {task}\")\n",
    "    \n",
    "    # Move inputs to the same device as the model\n",
    "    inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "    \n",
    "    return inputs"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Implement Post-Training Quantization (PTQ)\n",
    "\n",
    "We'll use PyTorch's built-in quantization functionality to convert our models to 8-bit integers."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def quantize_model_ptq(model_key):\n",
    "    \"\"\"Apply post-training quantization to a model.\"\"\"\n",
    "    # Load model and tokenizer\n",
    "    model, tokenizer, device = load_model(model_key)\n",
    "    \n",
    "    # Prepare inputs\n",
    "    inputs = prepare_inputs(model_key, tokenizer, device)\n",
    "    \n",
    "    # Create directory for quantized model\n",
    "    model_name = model_info[model_key][\"model_name\"].replace(\"/\", \"_\")\n",
    "    quantized_dir = os.path.join(\"models\", f\"{model_name}_quantized_ptq\")\n",
    "    os.makedirs(quantized_dir, exist_ok=True)\n",
    "    \n",
    "    print(f\"Quantizing {model_name} using PTQ...\")\n",
    "    \n",
    "    # Move model to CPU for quantization\n",
    "    model = model.cpu()\n",
    "    inputs = {k: v.cpu() for k, v in inputs.items()}\n",
    "    \n",
    "    # Configure quantization\n",
    "    model.qconfig = torch.quantization.get_default_qconfig('fbgemm')\n",
    "    \n",
    "    # Prepare model for quantization\n",
    "    torch.quantization.prepare(model, inplace=True)\n",
    "    \n",
    "    # Calibrate with sample inputs (forward pass)\n",
    "    with torch.no_grad():\n",
    "        model(**inputs)\n",
    "    \n",
    "    # Convert to quantized model\n",
    "    torch.quantization.convert(model, inplace=True)\n",
    "    \n",
    "    # Save quantized model\n",
    "    torch.save(model.state_dict(), os.path.join(quantized_dir, \"pytorch_model.bin\"))\n",
    "    tokenizer.save_pretrained(quantized_dir)\n",
    "    \n",
    "    # Move model back to original device\n",
    "    model = model.to(device)\n",
    "    inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "    \n",
    "    # Measure metrics\n",
    "    model_size = get_model_size(model)\n",
    "    inference_time = measure_inference_time(model, inputs)\n",
    "    memory_usage = measure_memory_usage(model, inputs)\n",
    "    \n",
    "    # Run inference to get output\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    \n",
    "    return {\n",
    "        \"model_key\": model_key,\n",
    "        \"model_name\": model_info[model_key][\"model_name\"],\n",
    "        \"task\": model_info[model_key][\"task\"],\n",
    "        \"model_size\": model_size,  # MB\n",
    "        \"inference_time\": inference_time,  # ms\n",
    "        \"memory_usage\": memory_usage,  # MB\n",
    "        \"quantized_outputs\": outputs,\n",
    "        \"quantized_path\": quantized_dir\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Implement Dynamic Quantization\n",
    "\n",
    "Dynamic quantization quantizes the weights to int8 but keeps activations in floating point."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def quantize_model_dynamic(model_key):\n",
    "    \"\"\"Apply dynamic quantization to a model.\"\"\"\n",
    "    # Load model and tokenizer\n",
    "    model, tokenizer, device = load_model(model_key)\n",
    "    \n",
    "    # Prepare inputs\n",
    "    inputs = prepare_inputs(model_key, tokenizer, device)\n",
    "    \n",
    "    # Create directory for quantized model\n",
    "    quantized_dir = os.path.join(\"quantized_models\", f\"{model_key}_dynamic\")\n",
    "    os.makedirs(quantized_dir, exist_ok=True)\n",
    "    \n",
    "    # Check if we can use Intel Neural Compressor for better CPU performance\n",
    "    if intel_optimum_available and device.type == \"cpu\":\n",
    "        try:\n",
    "            print(\"Using Intel Neural Compressor for quantization...\")\n",
    "            task = model_info[model_key][\"task\"]\n",
    "            model_path = model_info[model_key][\"local_path\"]\n",
    "            \n",
    "            # Use Intel Neural Compressor for quantization\n",
    "            quantizer = INCQuantizer.from_pretrained(model_path)\n",
    "            \n",
    "            # Apply dynamic quantization\n",
    "            quantized_model = quantizer.quantize(save_directory=quantized_dir, quantization_approach=\"dynamic\")\n",
    "            \n",
    "            # Load the quantized model based on task\n",
    "            if task == \"sequence-classification\":\n",
    "                model = INCModelForSequenceClassification.from_pretrained(quantized_dir)\n",
    "            elif task == \"token-classification\":\n",
    "                model = INCModelForTokenClassification.from_pretrained(quantized_dir)\n",
    "            elif task == \"question-answering\":\n",
    "                model = INCModelForQuestionAnswering.from_pretrained(quantized_dir)\n",
    "            else:\n",
    "                # Fall back to PyTorch quantization for unsupported tasks\n",
    "                raise ValueError(f\"Task {task} not supported by Intel Neural Compressor\")\n",
    "                \n",
    "            # Measure metrics\n",
    "            model_size = get_model_size(model)\n",
    "            inference_time = measure_inference_time(model, inputs)\n",
    "            memory_usage = measure_memory_usage(model, inputs)\n",
    "            \n",
    "            # Run inference to get output\n",
    "            with torch.no_grad():\n",
    "                outputs = model(**inputs)\n",
    "                \n",
    "            return {\n",
    "                \"model_key\": model_key,\n",
    "                \"model_name\": model_info[model_key][\"model_name\"],\n",
    "                \"task\": task,\n",
    "                \"model_size\": model_size,  # MB\n",
    "                \"inference_time\": inference_time,  # ms\n",
    "                \"memory_usage\": memory_usage,  # MB\n",
    "                \"quantized_outputs\": outputs,\n",
    "                \"quantized_path\": quantized_dir\n",
    "            }\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f\"Intel Neural Compressor failed: {e}. Falling back to PyTorch quantization.\")\n",
    "    \n",
    "    # Fall back to PyTorch quantization\n",
    "    print(\"Using PyTorch dynamic quantization...\")\n",
    "    \n",
    "    # Move model to CPU for quantization\n",
    "    model = model.cpu()\n",
    "    inputs = {k: v.cpu() for k, v in inputs.items()}\n",
    "    \n",
    "    # Apply dynamic quantization\n",
    "    model = torch.quantization.quantize_dynamic(\n",
    "        model, \n",
    "        {torch.nn.Linear}, \n",
    "        dtype=torch.qint8\n",
    "    )\n",
    "    \n",
    "    # Save quantized model\n",
    "    torch.save(model.state_dict(), os.path.join(quantized_dir, \"pytorch_model.bin\"))\n",
    "    tokenizer.save_pretrained(quantized_dir)\n",
    "    \n",
    "    # Move model back to original device\n",
    "    model = model.to(device)\n",
    "    inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "    \n",
    "    # Measure metrics\n",
    "    model_size = get_model_size(model)\n",
    "    inference_time = measure_inference_time(model, inputs)\n",
    "    memory_usage = measure_memory_usage(model, inputs)\n",
    "    \n",
    "    # Run inference to get output\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    \n",
    "    return {\n",
    "        \"model_key\": model_key,\n",
    "        \"model_name\": model_info[model_key][\"model_name\"],\n",
    "        \"task\": model_info[model_key][\"task\"],\n",
    "        \"model_size\": model_size,  # MB\n",
    "        \"inference_time\": inference_time,  # ms\n",
    "        \"memory_usage\": memory_usage,  # MB\n",
    "        \"quantized_outputs\": outputs,\n",
    "        \"quantized_path\": quantized_dir\n",
    "    }"
   ]
  }
   "outputs": [],
   "source": [
    "def quantize_model_dynamic(model_key):\n",
    "    \"\"\"Apply dynamic quantization to a model.\"\"\"\n",
    "    # Load model and tokenizer\n",
    "    model, tokenizer, device = load_model(model_key)\n",
    "    \n",
    "    # Prepare inputs\n",
    "    inputs = prepare_inputs(model_key, tokenizer, device)\n",
    "    \n",
    "    # Create directory for quantized model\n",
    "    model_name = model_info[model_key][\"model_name\"].replace(\"/\", \"_\")\n",
    "    quantized_dir = os.path.join(\"models\", f\"{model_name}_quantized_dynamic\")\n",
    "    os.makedirs(quantized_dir, exist_ok=True)\n",
    "    \n",
    "    print(f\"Quantizing {model_name} using dynamic quantization...\")\n",
    "    \n",
    "    # Move model to CPU for quantization\n",
    "    model = model.cpu()\n",
    "    inputs = {k: v.cpu() for k, v in inputs.items()}\n",
    "    \n",
    "    # Apply dynamic quantization\n",
    "    quantized_model = torch.quantization.quantize_dynamic(\n",
    "        model, {torch.nn.Linear}, dtype=torch.qint8\n",
    "    )\n",
    "    \n",
    "    # Save quantized model\n",
    "    torch.save(quantized_model.state_dict(), os.path.join(quantized_dir, \"pytorch_model.bin\"))\n",
    "    tokenizer.save_pretrained(quantized_dir)\n",
    "    \n",
    "    # Move model back to original device\n",
    "    quantized_model = quantized_model.to(device)\n",
    "    inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "    \n",
    "    # Measure metrics\n",
    "    model_size = get_model_size(quantized_model)\n",
    "    inference_time = measure_inference_time(quantized_model, inputs)\n",
    "    memory_usage = measure_memory_usage(quantized_model, inputs)\n",
    "    \n",
    "    # Run inference to get output\n",
    "    with torch.no_grad():\n",
    "        outputs = quantized_model(**inputs)\n",
    "    \n",
    "    return {\n",
    "        \"model_key\": model_key,\n",
    "        \"model_name\": model_info[model_key][\"model_name\"],\n",
    "        \"task\": model_info[model_key][\"task\"],\n",
    "        \"model_size\": model_size,  # MB\n",
    "        \"inference_time\": inference_time,  # ms\n",
    "        \"memory_usage\": memory_usage,  # MB\n",
    "        \"quantized_outputs\": outputs,\n",
    "        \"quantized_path\": quantized_dir\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Apply Quantization to Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply dynamic quantization to each model\n",
    "dynamic_quantized_metrics = {}\n",
    "for model_key in model_info.keys():\n",
    "    print(f\"\\nApplying dynamic quantization to {model_key}...\")\n",
    "    try:\n",
    "        dynamic_quantized_metrics[model_key] = quantize_model_dynamic(model_key)\n",
    "        \n",
    "        # Print metrics\n",
    "        print(f\"Model size: {dynamic_quantized_metrics[model_key]['model_size']:.2f} MB\")\n",
    "        print(f\"Inference time: {dynamic_quantized_metrics[model_key]['inference_time']:.2f} ms\")\n",
    "        print(f\"Memory usage: {dynamic_quantized_metrics[model_key]['memory_usage']:.2f} MB\")\n",
    "    except Exception as e:\n",
    "        print(f\"Error quantizing {model_key}: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Compare Baseline vs. Quantized Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create comparison data\n",
    "comparison_data = []\n",
    "\n",
    "for model_key in model_info.keys():\n",
    "    if model_key in dynamic_quantized_metrics:\n",
    "        baseline = baseline_metrics[model_key]\n",
    "        quantized = dynamic_quantized_metrics[model_key]\n",
    "        \n",
    "        model_name = baseline[\"model_name\"]\n",
    "        \n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Metric\": \"Size (MB)\",\n",
    "            \"Baseline\": baseline[\"model_size\"],\n",
    "            \"Quantized\": quantized[\"model_size\"],\n",
    "            \"Reduction (%)\": (1 - quantized[\"model_size\"] / baseline[\"model_size\"]) * 100\n",
    "        })\n",
    "        \n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Metric\": \"Inference Time (ms)\",\n",
    "            \"Baseline\": baseline[\"inference_time\"],\n",
    "            \"Quantized\": quantized[\"inference_time\"],\n",
    "            \"Reduction (%)\": (1 - quantized[\"inference_time\"] / baseline[\"inference_time\"]) * 100\n",
    "        })\n",
    "        \n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Metric\": \"Memory Usage (MB)\",\n",
    "            \"Baseline\": baseline[\"memory_usage\"],\n",
    "            \"Quantized\": quantized[\"memory_usage\"],\n",
    "            \"Reduction (%)\": (1 - quantized[\"memory_usage\"] / baseline[\"memory_usage\"]) * 100\n",
    "        })\n",
    "\n",
    "comparison_df = pd.DataFrame(comparison_data)\n",
    "comparison_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot size comparison\n",
