  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Save Quantized Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save quantized metrics (excluding outputs which aren't JSON serializable)\n",
    "serializable_metrics = {}\n",
    "for model_key, metrics in dynamic_quantized_metrics.items():\n",
    "    serializable_metrics[model_key] = {\n",
    "        \"model_key\": metrics[\"model_key\"],\n",
    "        \"model_name\": metrics[\"model_name\"],\n",
    "        \"task\": metrics[\"task\"],\n",
    "        \"model_size\": metrics[\"model_size\"],\n",
    "        \"inference_time\": metrics[\"inference_time\"],\n",
    "        \"memory_usage\": metrics[\"memory_usage\"],\n",
    "        \"quantized_path\": metrics[\"quantized_path\"]\n",
    "    }\n",
    "\n",
    "with open('quantized_metrics.json', 'w') as f:\n",
    "    json.dump(serializable_metrics, f, indent=2)\n",
    "\n",
    "print(\"Quantized metrics saved to quantized_metrics.json\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Estimate Cost Savings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def estimate_monthly_cost(model_metrics, requests_per_month=1000000):\n",
    "    \"\"\"Estimate monthly cost for running a model in production.\"\"\"\n",
    "    # Assumptions\n",
    "    compute_cost_per_hour = 0.5  # $0.5 per hour for compute (e.g., ml.g4dn.xlarge)\n",
    "    storage_cost_per_gb_month = 0.023  # $0.023 per GB-month for S3\n",
    "    \n",
    "    # Calculate compute cost\n",
    "    inference_time_hours = (model_metrics[\"inference_time\"] * requests_per_month) / (1000 * 60 * 60)\n",
    "    compute_cost = inference_time_hours * compute_cost_per_hour\n",
    "    \n",
    "    # Calculate storage cost\n",
    "    storage_cost = (model_metrics[\"model_size\"] / 1024) * storage_cost_per_gb_month\n",
    "    \n",
    "    # Total cost\n",
    "    total_cost = compute_cost + storage_cost\n",
    "    \n",
    "    return {\n",
    "        \"compute_cost\": compute_cost,\n",
    "        \"storage_cost\": storage_cost,\n",
    "        \"total_cost\": total_cost\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Estimate costs for baseline and quantized models\n",
    "cost_savings = []\n",
    "\n",
    "for model_key in dynamic_quantized_metrics.keys():\n",
    "    baseline_cost = estimate_monthly_cost(baseline_metrics[model_key])\n",
    "    quantized_cost = estimate_monthly_cost(serializable_metrics[model_key])\n",
    "    \n",
    "    savings = {\n",
    "        \"Model\": baseline_metrics[model_key][\"model_name\"],\n",
    "        \"Baseline Cost ($)\": baseline_cost[\"total_cost\"],\n",
    "        \"Quantized Cost ($)\": quantized_cost[\"total_cost\"],\n",
    "        \"Savings ($)\": baseline_cost[\"total_cost\"] - quantized_cost[\"total_cost\"],\n",
    "        \"Savings (%)\": (1 - quantized_cost[\"total_cost\"] / baseline_cost[\"total_cost\"]) * 100\n",
    "    }\n",
    "    \n",
    "    cost_savings.append(savings)\n",
    "\n",
    "savings_df = pd.DataFrame(cost_savings)\n",
    "savings_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot cost savings\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.barplot(x=\"Model\", y=\"value\", hue=\"variable\", data=pd.melt(savings_df, id_vars=[\"Model\"], value_vars=[\"Baseline Cost ($)\", \"Quantized Cost ($)\"]))\n",
    "plt.title(\"Cost Comparison: Baseline vs. Quantized (1M requests/month)\")\n",
    "plt.ylabel(\"Monthly Cost ($)\")\n",
    "plt.xticks(rotation=45, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
