{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Baseline Model Evaluation\n",
    "\n",
    "In this notebook, we'll establish baseline performance metrics for each model. These metrics will serve as a reference point to measure the impact of our optimization techniques."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import json\n",
    "import torch\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, AutoModelForTokenClassification\n",
    "from transformers import AutoModelForQuestionAnswering, AutoModelForMaskedLM\n",
    "import boto3\n",
    "\n",
    "# Import utility functions\n",
    "from utils import (\n",
    "    measure_inference_time,\n",
    "    get_model_size,\n",
    "    measure_memory_usage,\n",
    "    plot_comparison,\n",
    "    estimate_monthly_cost,\n",
    "    load_model_and_tokenizer,\n",
    "    prepare_inputs as utils_prepare_inputs  # Rename to avoid conflict\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Workshop Settings\n",
    "\n",
    "Load the workshop settings that were configured in the first notebook."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load stored variables\n",
    "%store -r S3_BUCKET\n",
    "%store -r AWS_REGION\n",
    "%store -r SAGEMAKER_ROLE_ARN\n",
    "%store -r OPTIMIZATION_INSTANCE_TYPE\n",
    "\n",
    "# Check if variables were successfully retrieved\n",
    "if 'S3_BUCKET' in locals() and S3_BUCKET != \"YOUR_BUCKET_NAME_HERE\":\n",
    "    print(\"Workshop settings loaded successfully:\")\n",
    "    print(f\"S3 Bucket: {S3_BUCKET}\")\n",
    "    print(f\"AWS Region: {AWS_REGION}\")\n",
    "else:\n",
    "    print(\"⚠️ Workshop settings not found or not configured.\")\n",
    "    print(\"Please run the first notebook (01_introduction_and_setup.ipynb) to configure settings.\")\n",
    "    \n",
    "    # Provide opportunity to set values here if needed\n",
    "    print(\"\\nYou can also set the values directly here:\")\n",
    "    new_bucket = input(\"S3 Bucket Name: \")\n",
    "    if new_bucket:\n",
    "        S3_BUCKET = new_bucket\n",
    "        \n",
    "    new_region = input(\"AWS Region: \")\n",
    "    if new_region:\n",
    "        AWS_REGION = new_region\n",
    "        \n",
    "    # Store the updated values\n",
    "    %store S3_BUCKET\n",
    "    %store AWS_REGION"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Model Information"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load model information from file\n",
    "with open('model_info.json', 'r') as f:\n",
    "    model_info = json.load(f)\n",
    "\n",
    "print(f\"Loaded information for {len(model_info)} models\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Define Sample Inputs for Each Task"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define sample inputs for each task\n",
    "sample_inputs = {\n",
    "    \"sentiment_analysis\": \"I really enjoyed this movie. The acting was superb and the plot was engaging.\",\n",
    "    \"ner\": \"Jeff Bezos founded Amazon in 1994 and the company is headquartered in Seattle, Washington.\",\n",
    "    \"question_answering\": {\n",
    "        \"question\": \"What is machine learning?\",\n",
    "        \"context\": \"Machine learning is a branch of artificial intelligence that focuses on building systems that learn from data.\"\n",
    "    },\n",
    "    \"masked_lm\": \"The [MASK] is a large language model trained by OpenAI.\"\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Create Function to Load Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_model(model_key):\n",
    "    \"\"\"Load model and tokenizer from local path.\"\"\"\n",
    "    model_data = model_info[model_key]\n",
    "    model_path = model_data[\"local_path\"]\n",
    "    task = model_data[\"task\"]\n",
    "    \n",
    "    print(f\"Loading {model_data['model_name']} for {task}...\")\n",
    "    \n",
    "    # Use utility function from utils.py\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    model, tokenizer = load_model_and_tokenizer(model_path, task, device)\n",
    "    \n",
    "    return model, tokenizer, device"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Create Function to Prepare Inputs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_inputs_for_model(model_key, tokenizer, device):\n",
    "    \"\"\"Prepare inputs for the model based on task.\"\"\"\n",
    "    task = model_info[model_key][\"task\"]\n",
    "    sample_input = sample_inputs[model_key]\n",
    "    \n",
    "    # Use utility function imported from utils.py with the renamed import\n",
    "    return utils_prepare_inputs(task, sample_input, tokenizer, device)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Measure Baseline Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def measure_baseline_metrics(model_key):\n",
    "    \"\"\"Measure baseline metrics for a model.\"\"\"\n",
    "    # Load model and tokenizer\n",
    "    model, tokenizer, device = load_model(model_key)\n",
    "    \n",
    "    # Prepare inputs\n",
    "    inputs = prepare_inputs_for_model(model_key, tokenizer, device)\n",
    "    \n",
    "    # Measure model size\n",
    "    model_size = get_model_size(model)\n",
    "    \n",
    "    # Measure inference time\n",
    "    inference_time = measure_inference_time(model, inputs)\n",
    "    \n",
    "    # Measure memory usage\n",
    "    memory_usage = measure_memory_usage(model, inputs)\n",
    "    \n",
    "    # Get number of parameters\n",
    "    num_params = sum(p.numel() for p in model.parameters())\n",
    "    \n",
    "    # Run inference to get output for accuracy comparison later\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    \n",
    "    return {\n",
    "        \"model_key\": model_key,\n",
    "        \"model_name\": model_info[model_key][\"model_name\"],\n",
    "        \"task\": model_info[model_key][\"task\"],\n",
    "        \"model_size\": model_size,  # MB\n",
    "        \"inference_time\": inference_time,  # ms\n",
    "        \"memory_usage\": memory_usage,  # MB\n",
    "        \"num_parameters\": num_params,\n",
    "        \"baseline_outputs\": outputs,\n",
    "        \"inputs\": inputs\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Measure baseline metrics for each model\n",
    "baseline_metrics = {}\n",
    "for model_key in model_info.keys():\n",
    "    print(f\"\\nMeasuring baseline metrics for {model_key}...\")\n",
    "    baseline_metrics[model_key] = measure_baseline_metrics(model_key)\n",
    "    \n",
    "    # Print metrics\n",
    "    print(f\"Model size: {baseline_metrics[model_key]['model_size']:.2f} MB\")\n",
    "    print(f\"Inference time: {baseline_metrics[model_key]['inference_time']:.2f} ms\")\n",
    "    print(f\"Memory usage: {baseline_metrics[model_key]['memory_usage']:.2f} MB\")\n",
    "    print(f\"Number of parameters: {baseline_metrics[model_key]['num_parameters']:,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Save Baseline Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save baseline metrics (excluding outputs and inputs which aren't JSON serializable)\n",
    "serializable_metrics = {}\n",
    "for model_key, metrics in baseline_metrics.items():\n",
    "    serializable_metrics[model_key] = {\n",
    "        \"model_key\": metrics[\"model_key\"],\n",
    "        \"model_name\": metrics[\"model_name\"],\n",
    "        \"task\": metrics[\"task\"],\n",
    "        \"model_size\": metrics[\"model_size\"],\n",
    "        \"inference_time\": metrics[\"inference_time\"],\n",
    "        \"memory_usage\": metrics[\"memory_usage\"],\n",
    "        \"num_parameters\": metrics[\"num_parameters\"]\n",
    "    }\n",
    "\n",
    "with open('baseline_metrics.json', 'w') as f:\n",
    "    json.dump(serializable_metrics, f, indent=2)\n",
    "\n",
    "print(\"Baseline metrics saved to baseline_metrics.json\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Display Baseline Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a DataFrame with the metrics for better display\n",
    "model_names = [metrics[\"model_name\"] for metrics in serializable_metrics.values()]\n",
    "model_sizes = [metrics[\"model_size\"] for metrics in serializable_metrics.values()]\n",
    "inference_times = [metrics[\"inference_time\"] for metrics in serializable_metrics.values()]\n",
    "memory_usages = [metrics[\"memory_usage\"] for metrics in serializable_metrics.values()]\n",
    "num_parameters = [metrics[\"num_parameters\"] for metrics in serializable_metrics.values()]\n",
    "\n",
    "# Create a DataFrame\n",
    "metrics_df = pd.DataFrame({\n",
    "    \"Model\": model_names,\n",
    "    \"Size (MB)\": model_sizes,\n",
    "    \"Inference Time (ms)\": inference_times,\n",
    "    \"Memory Usage (MB)\": memory_usages,\n",
    "    \"Parameters\": num_parameters\n",
    "})\n",
    "\n",
    "# Display the metrics table\n",
    "metrics_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Estimate Baseline Costs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Estimate costs for each model\n",
    "cost_estimates = {}\n",
    "for model_key, metrics in serializable_metrics.items():\n",
    "    cost_estimates[model_key] = estimate_monthly_cost(metrics)\n",
    "\n",
    "# Create a DataFrame for cost estimates\n",
    "cost_data = []\n",
    "for model_key, costs in cost_estimates.items():\n",
    "    model_name = serializable_metrics[model_key][\"model_name\"]\n",
    "    cost_data.append({\n",
    "        \"Model\": model_name,\n",
    "        \"Compute Cost ($)\": costs[\"compute_cost\"],\n",
    "        \"Storage Cost ($)\": costs[\"storage_cost\"],\n",
    "        \"Total Cost ($)\": costs[\"total_cost\"]\n",
    "    })\n",
    "\n",
    "# Display the cost estimates table\n",
    "cost_df = pd.DataFrame(cost_data)\n",
    "cost_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Next Steps\n",
    "\n",
    "Now that we've established baseline metrics for our models, we're ready to apply optimization techniques. In the next notebook, we'll explore quantization to reduce model size and improve inference speed."
   ]
  }
   ]
  },
