   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Define Sample Inputs for Each Task"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define sample inputs for each task\n",
    "sample_inputs = {\n",
    "    \"sentiment_analysis\": \"I really enjoyed this movie. The acting was superb and the plot was engaging.\",\n",
    "    \"ner\": \"Jeff Bezos founded Amazon in 1994 and the company is headquartered in Seattle, Washington.\",\n",
    "    \"question_answering\": {\n",
    "        \"question\": \"What is machine learning?\",\n",
    "        \"context\": \"Machine learning is a branch of artificial intelligence that focuses on building systems that learn from data.\"\n",
    "    },\n",
    "    \"masked_lm\": \"The [MASK] is a large language model trained by OpenAI.\"\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Create Functions for Loading Models and Preparing Inputs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_model(model_path, task, device=None):\n",
    "    \"\"\"Load model and tokenizer from local path.\"\"\"\n",
    "    if device is None:\n",
    "        device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    \n",
    "    # Load tokenizer\n",
    "    tokenizer = AutoTokenizer.from_pretrained(model_path)\n",
    "    \n",
    "    # Load model based on task\n",
    "    if task == \"sequence-classification\":\n",
    "        model = AutoModelForSequenceClassification.from_pretrained(model_path)\n",
    "    elif task == \"token-classification\":\n",
    "        model = AutoModelForTokenClassification.from_pretrained(model_path)\n",
    "    elif task == \"question-answering\":\n",
    "        model = AutoModelForQuestionAnswering.from_pretrained(model_path)\n",
    "    elif task == \"masked-lm\":\n",
    "        model = AutoModelForMaskedLM.from_pretrained(model_path)\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported task: {task}\")\n",
    "    \n",
    "    # Move model to device\n",
    "    model = model.to(device)\n",
    "    model.eval()  # Set model to evaluation mode\n",
    "    \n",
    "    return model, tokenizer\n",
    "\n",
    "def prepare_inputs(task, sample_input, tokenizer, device):\n",
    "    \"\"\"Prepare inputs for the model based on task.\"\"\"\n",
    "    if task == \"sequence-classification\" or task == \"token-classification\":\n",
    "        inputs = tokenizer(sample_input, return_tensors=\"pt\")\n",
    "    elif task == \"question-answering\":\n",
    "        inputs = tokenizer(sample_input[\"question\"], sample_input[\"context\"], return_tensors=\"pt\")\n",
    "    elif task == \"masked-lm\":\n",
    "        inputs = tokenizer(sample_input, return_tensors=\"pt\")\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported task: {task}\")\n",
    "    \n",
    "    # Move inputs to the same device as the model\n",
    "    inputs = {k: v.to(device) for k, v in inputs.items()}\n",
    "    \n",
    "    return inputs"
   ]
  }
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Measure Inference Performance for All Models"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def measure_model_performance(model_path, task, sample_input, num_runs=100):\n",
    "    \"\"\"Measure inference performance for a model.\"\"\"\n",
    "    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "    \n",
    "    # Load model and tokenizer\n",
    "    model, tokenizer = load_model(model_path, task, device)\n",
    "    \n",
    "    # Prepare inputs\n",
    "    inputs = prepare_inputs(task, sample_input, tokenizer, device)\n",
    "    \n",
    "    # Measure model size\n",
    "    model_size = get_model_size(model)\n",
    "    \n",
    "    # Measure inference time\n",
    "    inference_time = measure_inference_time(model, inputs, num_runs=num_runs)\n",
    "    \n",
    "    # Measure memory usage\n",
    "    memory_usage = measure_memory_usage(model, inputs)\n",
    "    \n",
    "    # Calculate throughput (requests per second)\n",
    "    throughput = 1000 / inference_time  # Convert ms to seconds\n",
    "    \n",
    "    # Run inference to get output\n",
    "    with torch.no_grad():\n",
    "        outputs = model(**inputs)\n",
    "    \n",
    "    return {\n",
    "        \"model_size\": model_size,  # MB\n",
    "        \"inference_time\": inference_time,  # ms\n",
    "        \"memory_usage\": memory_usage,  # MB\n",
    "        \"throughput\": throughput,  # requests per second\n",
    "        \"outputs\": outputs\n",
    "    }"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Collect all model paths and types\n",
    "model_paths = {}\n",
    "\n",
    "for model_key in model_info.keys():\n",
    "    model_paths[model_key] = {\n",
    "        \"baseline\": model_info[model_key][\"local_path\"],\n",
    "        \"task\": model_info[model_key][\"task\"]\n",
    "    }\n",
    "    \n",
    "    # Add quantized model path if available\n",
    "    if model_key in quantized_metrics and \"quantized_path\" in quantized_metrics[model_key]:\n",
    "        model_paths[model_key][\"quantized\"] = quantized_metrics[model_key][\"quantized_path\"]\n",
    "    \n",
    "    # Add pruned model path if available\n",
    "    if model_key in pruned_metrics and \"pruned_path\" in pruned_metrics[model_key]:\n",
    "        model_paths[model_key][\"pruned\"] = pruned_metrics[model_key][\"pruned_path\"]\n",
    "    \n",
    "    # Add distilled model path if available\n",
    "    if model_key in distilled_metrics and \"distilled_path\" in distilled_metrics[model_key]:\n",
    "        model_paths[model_key][\"distilled\"] = distilled_metrics[model_key][\"distilled_path\"]\n",
    "\n",
    "print(f\"Collected paths for {len(model_paths)} models\")"
   ]
  }
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Measure performance for all models\n",
    "performance_results = {}\n",
    "\n",
    "for model_key, paths in model_paths.items():\n",
    "    performance_results[model_key] = {}\n",
    "    task = paths[\"task\"]\n",
    "    sample_input = sample_inputs[model_key]\n",
    "    \n",
    "    print(f\"\\nMeasuring performance for {model_key} models...\")\n",
    "    \n",
    "    # Measure baseline performance\n",
    "    print(\"  Measuring baseline model...\")\n",
    "    performance_results[model_key][\"baseline\"] = measure_model_performance(\n",
    "        paths[\"baseline\"], task, sample_input\n",
    "    )\n",
    "    \n",
    "    # Measure quantized performance if available\n",
    "    if \"quantized\" in paths:\n",
    "        print(\"  Measuring quantized model...\")\n",
    "        performance_results[model_key][\"quantized\"] = measure_model_performance(\n",
    "            paths[\"quantized\"], task, sample_input\n",
    "        )\n",
    "    \n",
    "    # Measure pruned performance if available\n",
    "    if \"pruned\" in paths:\n",
    "        print(\"  Measuring pruned model...\")\n",
    "        performance_results[model_key][\"pruned\"] = measure_model_performance(\n",
    "            paths[\"pruned\"], task, sample_input\n",
    "        )\n",
    "    \n",
    "    # Measure distilled performance if available\n",
    "    if \"distilled\" in paths:\n",
    "        print(\"  Measuring distilled model...\")\n",
    "        performance_results[model_key][\"distilled\"] = measure_model_performance(\n",
    "            paths[\"distilled\"], task, sample_input\n",
    "        )"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Compare Inference Performance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create comparison data\n",
    "comparison_data = []\n",
    "\n",
    "for model_key, results in performance_results.items():\n",
    "    model_name = model_info[model_key][\"model_name\"]\n",
    "    \n",
    "    # Get baseline metrics\n",
    "    baseline = results[\"baseline\"]\n",
    "    \n",
    "    # Add baseline data\n",
    "    comparison_data.append({\n",
    "        \"Model\": model_name,\n",
    "        \"Type\": \"Baseline\",\n",
    "        \"Size (MB)\": baseline[\"model_size\"],\n",
    "        \"Inference Time (ms)\": baseline[\"inference_time\"],\n",
    "        \"Throughput (req/s)\": baseline[\"throughput\"],\n",
    "        \"Memory Usage (MB)\": baseline[\"memory_usage\"]\n",
    "    })\n",
    "    \n",
    "    # Add quantized data if available\n",
    "    if \"quantized\" in results:\n",
    "        quantized = results[\"quantized\"]\n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Type\": \"Quantized\",\n",
    "            \"Size (MB)\": quantized[\"model_size\"],\n",
    "            \"Inference Time (ms)\": quantized[\"inference_time\"],\n",
    "            \"Throughput (req/s)\": quantized[\"throughput\"],\n",
    "            \"Memory Usage (MB)\": quantized[\"memory_usage\"]\n",
    "        })\n",
    "    \n",
    "    # Add pruned data if available\n",
    "    if \"pruned\" in results:\n",
    "        pruned = results[\"pruned\"]\n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Type\": \"Pruned\",\n",
    "            \"Size (MB)\": pruned[\"model_size\"],\n",
    "            \"Inference Time (ms)\": pruned[\"inference_time\"],\n",
    "            \"Throughput (req/s)\": pruned[\"throughput\"],\n",
    "            \"Memory Usage (MB)\": pruned[\"memory_usage\"]\n",
    "        })\n",
    "    \n",
    "    # Add distilled data if available\n",
    "    if \"distilled\" in results:\n",
    "        distilled = results[\"distilled\"]\n",
    "        comparison_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Type\": \"Distilled\",\n",
    "            \"Size (MB)\": distilled[\"model_size\"],\n",
    "            \"Inference Time (ms)\": distilled[\"inference_time\"],\n",
    "            \"Throughput (req/s)\": distilled[\"throughput\"],\n",
    "            \"Memory Usage (MB)\": distilled[\"memory_usage\"]\n",
    "        })\n",
    "\n",
    "# Create DataFrame\n",
    "comparison_df = pd.DataFrame(comparison_data)\n",
    "comparison_df"
   ]
  }
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Visualize Performance Comparisons"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Function to plot comparison for a specific metric\n",
    "def plot_metric_comparison(df, metric, title, ylabel, higher_is_better=False):\n",
    "    plt.figure(figsize=(12, 6))\n",
    "    \n",
    "    # Create grouped bar plot\n",
    "    sns.barplot(x=\"Model\", y=metric, hue=\"Type\", data=df)\n",
    "    \n",
    "    plt.title(title)\n",
    "    plt.ylabel(ylabel)\n",
    "    plt.xticks(rotation=45, ha=\"right\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
