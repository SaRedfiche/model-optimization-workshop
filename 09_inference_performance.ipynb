  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Calculate Improvement Percentages"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate improvement percentages\n",
    "improvement_data = []\n",
    "\n",
    "for model_key, results in performance_results.items():\n",
    "    model_name = model_info[model_key][\"model_name\"]\n",
    "    baseline = results[\"baseline\"]\n",
    "    \n",
    "    # Calculate improvements for quantized model if available\n",
    "    if \"quantized\" in results:\n",
    "        quantized = results[\"quantized\"]\n",
    "        improvement_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Optimization\": \"Quantization\",\n",
    "            \"Size Reduction (%)\": (1 - quantized[\"model_size\"] / baseline[\"model_size\"]) * 100,\n",
    "            \"Latency Reduction (%)\": (1 - quantized[\"inference_time\"] / baseline[\"inference_time\"]) * 100,\n",
    "            \"Throughput Improvement (%)\": (quantized[\"throughput\"] / baseline[\"throughput\"] - 1) * 100,\n",
    "            \"Memory Reduction (%)\": (1 - quantized[\"memory_usage\"] / baseline[\"memory_usage\"]) * 100\n",
    "        })\n",
    "    \n",
    "    # Calculate improvements for pruned model if available\n",
    "    if \"pruned\" in results:\n",
    "        pruned = results[\"pruned\"]\n",
    "        improvement_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Optimization\": \"Pruning\",\n",
    "            \"Size Reduction (%)\": (1 - pruned[\"model_size\"] / baseline[\"model_size\"]) * 100,\n",
    "            \"Latency Reduction (%)\": (1 - pruned[\"inference_time\"] / baseline[\"inference_time\"]) * 100,\n",
    "            \"Throughput Improvement (%)\": (pruned[\"throughput\"] / baseline[\"throughput\"] - 1) * 100,\n",
    "            \"Memory Reduction (%)\": (1 - pruned[\"memory_usage\"] / baseline[\"memory_usage\"]) * 100\n",
    "        })\n",
    "    \n",
    "    # Calculate improvements for distilled model if available\n",
    "    if \"distilled\" in results:\n",
    "        distilled = results[\"distilled\"]\n",
    "        improvement_data.append({\n",
    "            \"Model\": model_name,\n",
    "            \"Optimization\": \"Distillation\",\n",
    "            \"Size Reduction (%)\": (1 - distilled[\"model_size\"] / baseline[\"model_size\"]) * 100,\n",
    "            \"Latency Reduction (%)\": (1 - distilled[\"inference_time\"] / baseline[\"inference_time\"]) * 100,\n",
    "            \"Throughput Improvement (%)\": (distilled[\"throughput\"] / baseline[\"throughput\"] - 1) * 100,\n",
    "            \"Memory Reduction (%)\": (1 - distilled[\"memory_usage\"] / baseline[\"memory_usage\"]) * 100\n",
    "        })\n",
    "\n",
    "# Create DataFrame\n",
    "improvement_df = pd.DataFrame(improvement_data)\n",
    "improvement_df"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot improvement percentages\n",
    "plt.figure(figsize=(15, 10))\n",
    "\n",
    "# Create a 2x2 grid of subplots\n",
    "fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "\n",
    "# Plot size reduction\n",
    "sns.barplot(x=\"Model\", y=\"Size Reduction (%)\", hue=\"Optimization\", data=improvement_df, ax=axes[0, 0])\n",
    "axes[0, 0].set_title(\"Size Reduction Percentage\")\n",
    "axes[0, 0].set_ylabel(\"Size Reduction (%)\")\n",
    "axes[0, 0].set_xticklabels(axes[0, 0].get_xticklabels(), rotation=45, ha=\"right\")\n",
    "\n",
    "# Plot latency reduction\n",
    "sns.barplot(x=\"Model\", y=\"Latency Reduction (%)\", hue=\"Optimization\", data=improvement_df, ax=axes[0, 1])\n",
    "axes[0, 1].set_title(\"Latency Reduction Percentage\")\n",
    "axes[0, 1].set_ylabel(\"Latency Reduction (%)\")\n",
    "axes[0, 1].set_xticklabels(axes[0, 1].get_xticklabels(), rotation=45, ha=\"right\")\n",
    "\n",
    "# Plot throughput improvement\n",
    "sns.barplot(x=\"Model\", y=\"Throughput Improvement (%)\", hue=\"Optimization\", data=improvement_df, ax=axes[1, 0])\n",
    "axes[1, 0].set_title(\"Throughput Improvement Percentage\")\n",
    "axes[1, 0].set_ylabel(\"Throughput Improvement (%)\")\n",
    "axes[1, 0].set_xticklabels(axes[1, 0].get_xticklabels(), rotation=45, ha=\"right\")\n",
    "\n",
    "# Plot memory reduction\n",
    "sns.barplot(x=\"Model\", y=\"Memory Reduction (%)\", hue=\"Optimization\", data=improvement_df, ax=axes[1, 1])\n",
    "axes[1, 1].set_title(\"Memory Reduction Percentage\")\n",
    "axes[1, 1].set_ylabel(\"Memory Reduction (%)\")\n",
    "axes[1, 1].set_xticklabels(axes[1, 1].get_xticklabels(), rotation=45, ha=\"right\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Analyze Trade-offs Between Size, Speed, and Accuracy"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a scatter plot to visualize the trade-offs\n",
    "plt.figure(figsize=(12, 8))\n",
    "\n",
    "# Create a scatter plot with size on x-axis and inference time on y-axis\n",
    "scatter = plt.scatter(\n",
    "    comparison_df[\"Size (MB)\"],\n",
    "    comparison_df[\"Inference Time (ms)\"],\n",
    "    c=comparison_df[\"Type\"].astype(\"category\").cat.codes,  # Color by model type\n",
    "    s=100,  # Marker size\n",
    "    alpha=0.7,  # Transparency\n",
    "    cmap=\"viridis\"  # Color map\n",
    ")\n",
    "\n",
    "# Add labels for each point\n",
    "for i, row in comparison_df.iterrows():\n",
    "    plt.annotate(\n",
    "        f\"{row['Model']} ({row['Type']})\",\n",
