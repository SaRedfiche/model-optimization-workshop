    "            '--model-info-path', '/opt/ml/processing/input/data/model_info.json',\n",
    "            '--output-dir', '/opt/ml/processing/output',\n",
    "            '--pruning-method', 'l1_unstructured',\n",
    "            '--pruning-amount', '0.3'\n",
