    "        f'temp_{model_key}_info.json', \n",
    "        S3_BUCKET, \n",
    "        f'optimization/inputs/{model_key}/model_info.json'\n",
    "    )\n",
    "    \n",
    "    # Define inputs and outputs\n",
    "    inputs = [\n",
    "        ProcessingInput(\n",
    "            source=f's3://{S3_BUCKET}/scripts/pruning_script.py',\n",
